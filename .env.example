# Copier ce fichier en .env et le compléter. Le fichier .env n'est jamais commité.

# Instance GitLab (par défaut https://gitlab.com).
GITLAB_URL=https://gitlab.com

# Jeton d'accès GitLab, portée read_api uniquement (lecture seule).
# Il reste côté serveur : le navigateur ne le voit jamais. Ne jamais le committer ni l'afficher.
# Tout le monde voit ce que ce jeton voit : choisir un compte dont les droits conviennent.
GITLAB_TOKEN=

# Chemin complet du groupe racine (obligatoire, sauf en mode démo).
# Les couloirs par défaut sont ses sous-groupes directs ; les epics et issues de tous
# ses descendants sont lus.
GITLAB_GROUP=

# Cadence d'itérations affichée : son titre ou son id. Par défaut, la cadence qui
# contient l'itération en cours.
# GITLAB_CADENCE=Sprints de deux semaines

# Durée pendant laquelle les données sont fraîches (durée Go : 30s, 5m, 1h). Au-delà,
# elles sont servies telles quelles pendant qu'une synchro les rafraîchit, et gardées 24 h.
CACHE_TTL=5m

# Fuseau horaire : il décide de l'itération en cours.
TZ=Europe/Paris

# 1 (ou true) : sert le jeu de démonstration de la maquette, sans GitLab.
# Les variables GITLAB_* sont alors ignorées.
GLEIPNIR_DEMO=

# Port de l'hôte où docker compose publie l'interface (par défaut 80).
GLEIPNIR_PORT=80
