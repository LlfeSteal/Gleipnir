server {
    # nginx-unprivileged runs as a non-root user: it can't bind port 80.
    listen 8080;
    server_name localhost;
    server_tokens off;

    root /usr/share/nginx/html;

    # The board of a large group is a few MB of JSON: compressed, about ten times less.
    gzip on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_types application/json application/javascript text/javascript text/css image/svg+xml;

    # Security headers, on every response (`always`: errors too). The locations below set their
    # caching with `expires`, never `add_header`: an add_header in a location would drop these.
    # CSP: the only inline script is the theme script of index.html, allowed by its hash — it
    # must be recomputed whenever that script changes (see AGENTS.md). Inline styles are
    # allowed because React sets style attributes (GitLab label colors, positions); the
    # favicon is a data: URI.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-R3Z8n9lDuyFyeR0wmF8bUiWIBRE0txtNyGGWeqLRsRg='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;

    # Hashed by Vite: a new build gets new names, so they can be cached for good.
    location /assets/ {
        try_files $uri =404;
        expires max;
    }

    # The entry point names the current assets: always revalidated.
    location = /index.html {
        expires -1;
    }

    # Single-page app: unknown paths get index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Transparent proxy to the Go backend. GLEIPNIR_BACKEND_URL is substituted when the
    # container starts (envsubst on /etc/nginx/templates); nginx variables are left alone.
    location /api/ {
        proxy_pass ${GLEIPNIR_BACKEND_URL}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The backend sets nosniff too: drop its copy so the response carries the header once.
        proxy_hide_header X-Content-Type-Options;
        proxy_connect_timeout 5s; # fail fast when the backend is down
        # A cold sync of a large group walks many GitLab pages; later requests hit the cache.
        proxy_read_timeout 300s;
    }
}
